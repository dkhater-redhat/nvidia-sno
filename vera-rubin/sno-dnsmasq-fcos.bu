variant: fcos
version: 1.5.0

ignition:
  config:
    merge:
      - local: bootstrap-in-place-for-live-iso.ign

passwd:
  users:
    - name: core
      password_hash: "$6$jamyHU6tcWovxP.e$rasKzY7tDn.LlazCF6Z4osY86aaXGEFOnkDSClPCw1B/DzPn2knv/kHCwncynti2r3k8MSLwcEsyEwqkDwZd8/"

storage:
  files:
    - path: /etc/NetworkManager/dnsmasq.d/ocp-sno.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          local=/vera-rubin.nvidia-preview/
          address=/api.vera-rubin.nvidia-preview/10.78.214.40
          address=/api-int.vera-rubin.nvidia-preview/10.78.214.40
          address=/apps.vera-rubin.nvidia-preview/10.78.214.40
          listen-address=127.0.0.1
          listen-address=10.78.214.40
          cache-size=1000

    - path: /etc/NetworkManager/conf.d/dnsmasq.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [main]
          dns=dnsmasq

    - path: /etc/ssh/sshd_config.d/01-password-auth.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          PasswordAuthentication yes

systemd:
  units:
    - name: dnsmasq.service
      enabled: false
      mask: false
